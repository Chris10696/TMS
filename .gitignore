# Market data and results (large, can be re-downloaded)
/data/
*.parquet

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets: never commit passwords, keys or tokens
.env
.env.*
secrets/
*.pem
*.key

# Machine-local and runtime files
/logs/
/artifacts/verify/
/artifacts/compaction/
/.atlas/supervisor.lock
/.atlas/hook-errors.log
/.claude/settings.local.json

# Compiled MQL5 files we build ourselves (the legacy .ex5 files are kept on purpose)
/mql5/**/*.ex5

# Third-party indicators, compiled black boxes and notes on the earlier build: this machine only
/legacy/local-only/
